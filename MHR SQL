        CASE WHEN MAX(t.as_of_date) = (SELECT MAX(as_of_date) FROM PC_FIVETRAN_DB.PRODUCTION_PUBLIC.STG_UNDERWRITING_MERCHANT_FLAG_TREATMENT WHERE flag_id = 'flag_00308')
