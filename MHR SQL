            raw_data_pool,
            feature_store,
            model_scores,
            decision_engine_output,
            metadata
        from PC_FIVETRAN_DB.PRODUCTION_PUBLIC.STG_UW_MAKE_DECISION_ARCHIVE_PROD
        qualify
            row_number() over (
                partition by application_id
                order by
                    metadata:decision_engine.start_time desc, decision_engine_output
            )
            = 1
    ) uw_s3
    on uw.application_id = uw_s3.application_id
      LEFT JOIN original_pricing OP ON OP.LEASE_ID = UW.LEASE_ID
      LEFT JOIN PC_FIVETRAN_DB.PRODUCTION_PUBLIC.LEASE ON LEASE.ID = UW.LEASE_ID
      LEFT JOIN PC_FIVETRAN_DB.S3.MERCHANT_RISK_TIRE_APPLIANCE_ZONE_20230707 AS zone_coc on zone_coc.zipcode = s.zipcode
      LEFT JOIN ONE_DOLLAR_TABLE AS od ON od.store_id = uw.store_id
      LEFT JOIN STORE_COC_SCORE AS scs on scs.id = uw.store_id
      LEFT JOIN EPO1_120_DAY_TABLE AS epo120 ON epo120.store_id = uw.store_id

      
      left join PC_FIVETRAN_DB.RISK_MODELING.KAFENE_STORES_IMAGE_MODEL_SCORES image_ms on image_ms.store_id = uw.store_id

      
      left join PC_FIVETRAN_DB.RISK_MODELING.LTO_COMPETITOR_SCORE_SCORES_20250911_SW_REV merchant_ms on merchant_ms.kafene_store_id = uw.store_id
      left join (
  select
    customer.description as application_id,
    count(dispute.id) as cnt_dispute,
    sum(dispute.amount)/100 as dispute_amount,
    sum(case when dispute.reason = 'fraudulent' then dispute.amount else 0 end)/100 as fraud_dispute_amount,
    count(case when dispute.reason = 'fraudulent' then dispute.id else null end) as fraud_dispute_count
  from PC_FIVETRAN_DB.STRIPE.CUSTOMER
  left join PC_FIVETRAN_DB.STRIPE.CHARGE on customer.id = charge.customer_id
  left join PC_FIVETRAN_DB.STRIPE.DISPUTE on charge.id = dispute.charge_id
  group by application_id
) disputes ON UW.application_id = disputes.application_id
      LEFT JOIN (
        SELECT application_id, final_projected_dollars, initial_lease_principle
        FROM PC_FIVETRAN_DB.PRODUCTION_PUBLIC.STG_COC_PROJECTIONS_RISK
        WHERE current_value_flag = 1
        ) AS i ON i.application_id = uw.application_id
      --LEFT JOIN "PC_FIVETRAN_DB"."PRODUCTION_PUBLIC"."APPLICATIONS" AS appl ON appl.id = uw.application_id
      LEFT JOIN (
        SELECT DISTINCT
          application_id,
          sim_decision
        FROM
          PC_FIVETRAN_DB.PRODUCTION_PUBLIC.STG_UW_SIMULATION_PROD_FINAL
      ) AS o ON o.application_id = uw.application_id
      LEFT JOIN PC_FIVETRAN_DB.PRODUCTION_PUBLIC.TBL_COC_FULL_POPULATION AS coc ON coc.application_id = uw.application_id
            LEFT JOIN PC_FIVETRAN_DB.PRODUCTION_PUBLIC.TBL_COC_FULL_POPULATION_V2 AS coc2 ON coc2.application_id = uw.application_id
      LEFT JOIN SWAP_IN_FLAG_TABLE AS swp ON swp.application_id = uw.application_id
      LEFT JOIN SWAP_IN_DATE AS SID ON SID.store_id = uw.store_id
      LEFT JOIN PC_FIVETRAN_DB.NATHAN_TEMP.BUCKET_TABLE_V2 AS btv2 ON uw.store_id = btv2.store_id
      LEFT JOIN (
        SELECT
          *
        FROM
          pc_fivetran_db.production_public.stg_merchant_behavior_score
        WHERE
          as_of_date = current_date()
      ) MBS ON MBS.STORE_ID = uw.store_id
      LEFT JOIN PC_FIVETRAN_DB.PRODUCTION_PUBLIC.tbl_app_expected_value EV ON EV.APPLICATION_ID = UW.APPLICATION_ID
      LEFT JOIN NEW_COC_MODEL_SCORE ON NEW_COC_MODEL_SCORE.APPLICATION_ID = UW.APPLICATION_ID
      LEFT JOIN store_pricing_with_pricing_tag HP on UW.store_id = HP.store_id
      and HP.pricing_tag is not null
      AND CASE
        WHEN UW.lease_id IS NOT NULL THEN UW.lease_contracted_date:: date = HP.as_of_date - 1
        ELSE UW.application_created_at:: date = HP.as_of_date - 1
      END
      AND UW.risk_tier BETWEEN HP.min_risk
      and HP.max_risk
    WHERE UW.vintage >= '2021-01'
    AND UW.merchant_id NOT IN ('MER-F2EE0')
  ),
  merchant_store_cnt AS (
    SELECT
      merchant_id,
      COUNT(id) AS merchant_store_id_count
    FROM
      "PC_FIVETRAN_DB"."PRODUCTION_PUBLIC"."STG_STORE"
    WHERE
      IS_STORE_LEVEL_BLOCKED = 'FALSE'
    GROUP BY
      1
  ),
  chain_store_cnt AS (
    SELECT
      property_chain_id,
      COUNT(id) AS chain_store_id_count
    FROM
      "PC_FIVETRAN_DB"."PRODUCTION_PUBLIC"."STG_STORE"
    WHERE
      IS_STORE_LEVEL_BLOCKED = 'FALSE'
    GROUP BY
      1
  ),
  cbb_score AS (
    SELECT
      LEFT (_file, 9) AS application_id,
      TO_NUMBER (xml_response: clear_bank_behavior.cbb_score2) AS cbb_score_2,
      SUM(
        CASE
          WHEN cbb_score_2 IS NULL THEN 1
          ELSE 0
        END
      ) AS missing_cbb_cnt
    FROM
      PC_FIVETRAN_DB.S3.CLARITY_S_3
    GROUP BY
      1,
      2
  ),
  MR_table AS (
    SELECT
      store_id,
      MAX(INITIAL_EXECUTION_DATE) AS recent_INITIAL_EXECUTION_DATE
    FROM
      PC_FIVETRAN_DB.PRODUCTION_PUBLIC.STG_STORE_RETENTION_PERIOD
    GROUP BY
      1
  )
SELECT DISTINCT
  a.*,
  case when swap_in_merchant_rule_flag = 1 then sig.swap_in_treatment_group else null end as swap_in_treatment_group,
  COALESCE(
    CC.chain_store_id_count,
    c.merchant_store_id_count
  ) AS multi_store_cnt,
  cbb.cbb_score_2,
  cbb.missing_cbb_cnt,
  max_tickets.key AS SMR_ticket,
  max_tickets.status AS SMR_status,
  max_tickets.goal_of_request,
  case
    when max_tickets.key is not null then 1
    else 0
  end as ticket_ever_flag,
  max_tickets.TICKET_CREATED_AT AS SMR_ticket_CREATED_AT,
  final_store_tier,
  is_undergoing_treatment,
  is_initial_tier,
  FIST_TIME_REFRESH_AFTER_TREATMENT_PERIOD,
  tr.min_monthly_vol,
  tr.adjustments,
  CASE
    WHEN APPLICATION_CREATED_AT_YMD BETWEEN BET_OPEN_DATE AND COALESCE (BET_CLOSE_DATE, CURRENT_DATE) THEN 1
    ELSE 0
  END AS APPS_DURING_SWAP_IN_TREATMENT_FLAG,
  SFT.BET_OPEN_DATE,
  SFT.bet_active as store_bet_active,
  ---- Supercharge flag at application date (respects treatment removal) ----
  CASE WHEN COALESCE(sc_app_store.supercharge_group, sc_app_merch.supercharge_group) IS NOT NULL THEN 1 ELSE 0 END AS app_supercharge_flag,
  COALESCE(sc_app_store.supercharge_group, sc_app_merch.supercharge_group) AS app_supercharge_group,
  ---- Store-level supercharge: current status + start/end dates ----
  COALESCE(sc_store_span.supercharge_group, sc_merch_span.supercharge_group) AS store_supercharge_group,
  COALESCE(sc_store_span.supercharge_start_date, sc_merch_span.supercharge_start_date) AS store_supercharge_start_date,
  COALESCE(sc_store_span.supercharge_last_seen_date, sc_merch_span.supercharge_last_seen_date) AS store_supercharge_last_seen_date,
  COALESCE(sc_store_span.supercharge_active, sc_merch_span.supercharge_active, 0) AS store_supercharge_active,
  CASE WHEN COALESCE(sc_store_span.supercharge_active, sc_merch_span.supercharge_active) = 1
       THEN COALESCE(sc_store_span.supercharge_group, sc_merch_span.supercharge_group) END AS store_current_supercharge_group,
 MDTF.related_keys,
 MDTF.most_recent_key_date,
 MDTF.most_recent_key,
 -- CASE
 --   WHEN MDTF.related_keys IS NULL THEN NULL
--    WHEN MDTF.RELATED_KEYS IS NOT NULL THEN MDTF.related_store_id
 -- END AS related_store_id,
  case
    when a.store_id = TR.STORE_ID then 1
    else 0
  end as treatment_review_flag,
  case
    when application_created_at_ymd <= protection_window_start then 'before'
    when application_created_at_ymd > protection_window_start then 'during'
    else null
  end as treatment_before_during,

CASE
    WHEN MS.coc_proj_simple >= 1.147 AND MS.FRAUD_MODEL_Q325 <= 0.0331 THEN 1
    WHEN MS.coc_proj_simple >= 1.147 AND MS.FRAUD_MODEL_Q325 > 0.0331 THEN 2

    WHEN MS.coc_proj_simple >= 1.0904 AND MS.coc_proj_simple < 1.147 
         AND MS.FRAUD_MODEL_Q325 <= 0.0331 THEN 3

    WHEN MS.coc_proj_simple >= 1.0904 AND MS.coc_proj_simple < 1.147 
         AND MS.FRAUD_MODEL_Q325 > 0.0331 AND MS.FRAUD_MODEL_Q325 <= 0.0758 THEN 4

    WHEN MS.coc_proj_simple >= 1.0144 AND MS.coc_proj_simple < 1.0904 
         AND MS.FRAUD_MODEL_Q325 <= 0.0671 THEN 5

    WHEN MS.coc_proj_simple >= 0.9765 AND MS.coc_proj_simple < 1.0144 
         AND MS.FRAUD_MODEL_Q325 <= 0.0417 THEN 6

    WHEN MS.coc_proj_simple >= 1.0904 AND MS.coc_proj_simple < 1.147 
         AND MS.FRAUD_MODEL_Q325 > 0.0758 THEN 7

    WHEN MS.coc_proj_simple >= 1.0144 AND MS.coc_proj_simple < 1.0904 
         AND MS.FRAUD_MODEL_Q325 > 0.0671 THEN 8

    WHEN MS.coc_proj_simple >= 0.9765 AND MS.coc_proj_simple < 1.0144 
         AND MS.FRAUD_MODEL_Q325 > 0.0417 AND MS.FRAUD_MODEL_Q325 <= 0.0758 THEN 9

    WHEN MS.coc_proj_simple < 0.9765 
         AND MS.FRAUD_MODEL_Q325 <= 0.0671 THEN 10

    WHEN MS.coc_proj_simple >= 0.9765 AND MS.coc_proj_simple < 1.0144 
         AND MS.FRAUD_MODEL_Q325 > 0.0758 THEN 11

    WHEN MS.coc_proj_simple < 0.9765 
         AND MS.FRAUD_MODEL_Q325 > 0.0671 AND MS.FRAUD_MODEL_Q325 <= 0.1017 THEN 12

    WHEN MS.coc_proj_simple < 0.9765 
         AND MS.FRAUD_MODEL_Q325 > 0.1017 THEN 13
END AS APP_LEVEL_SWAP_IN_GROUP,

      COALESCE(prod_v2.MERCHANT_QUALITY_SCORE, retro_v2.MQS_GEN2) AS MQS_V2_PROD_AND_RETRO,
      CASE
        WHEN prod_v2.MERCHANT_QUALITY_SCORE IS NOT NULL
          THEN TRY_CAST(PARSE_JSON(prod_v2.MODEL_SCORES):coc_score::VARCHAR AS NUMBER(18,5))
        ELSE retro_v2.COC_SCORE
      END AS MQS_Proj_COC,
      ms.coc_proj_simple as uw_proj_coc,
      deal.PROPERTY_TERMINATION_REASON

  
FROM
  pivot_base a
  LEFT JOIN merchant_store_cnt c ON a.merchant_id = c.merchant_id
  LEFT JOIN chain_store_cnt CC ON Cc.PROPERTY_CHAIN_ID = A.PROPERTY_CHAIN_ID
  LEFT JOIN cbb_score cbb ON cbb.application_id = a.application_id
  left join PC_FIVETRAN_DB.PRODUCTION_PUBLIC.STG_UW_SIMULATION_PROD_FINAL ff on ff.APPLICATION_ID = a.APPLICATION_ID
  LEFT JOIN (
    SELECT
  store_id,
  MAX(MINIMUM_MONTHLY_KAFENE_VOLUME_EXPECTED_FROM_THIS_STORE) AS min_monthly_vol,
  '[' || LISTAGG('"' || labels || '"', ', ') || ']' AS ADJUSTMENTS,
  MIN(protection_window_start) AS protection_window_start
FROM
  PC_FIVETRAN_DB.PRODUCTION_PUBLIC.STG_STORE_RETENTION_PERIOD
WHERE
  protection_expiration_date > CURRENT_DATE
GROUP BY
  store_id
  ) TR ON TR.STORE_ID = A.STORE_ID
  LEFT JOIN (
    SELECT
      STORE_ID,
      final_store_tier,
      is_undergoing_treatment,
      is_initial_tier,
      FIST_TIME_REFRESH_AFTER_TREATMENT_PERIOD
    FROM
      PC_FIVETRAN_DB.PRODUCTION_PUBLIC.stg_store_tiers_calculations
    WHERE
      AS_OF_DATE = DATE_TRUNC ('month', CURRENT_DATE)
  ) st ON st.store_id = a.store_id
  LEFT JOIN (
             SELECT
            store_id,
            key,
            status,
            TICKET_CREATED_AT,
            INITIAL_EXECUTION_DATE,
            goal_of_request,
            MAX_MONTHLY_POTENTIAL_LTO_VOLUME_FROM_THIS_STORE
        FROM (
            SELECT
                store_id,
                key,
                status,
                TICKET_CREATED_AT,
                INITIAL_EXECUTION_DATE,
                goal_of_request,
                MAX_MONTHLY_POTENTIAL_LTO_VOLUME_FROM_THIS_STORE,
                ROW_NUMBER() OVER (PARTITION BY store_id ORDER BY TICKET_CREATED_AT DESC) AS rn
            FROM
                PC_FIVETRAN_DB.PRODUCTION_PUBLIC.stg_store_retention_period WHERE LEFT(KEY,3) in ('SMR','DDM','MHR') AND STATUS not in ('Do Nothing','TURNED OFF')
        ) subquery
        WHERE
            subquery.rn <= 1
  ) AS max_tickets ON max_tickets.store_id = a.store_id
  LEFT JOIN PC_FIVETRAN_DB.NATHAN_TEMP.SUPERCHARGE_FLAG_TABLE SFT ON SFT.STORE_ID = A.STORE_ID
  ---- Supercharge at app date: store-level wins, merchant-level fallback ----
  LEFT JOIN sc_app_store ON sc_app_store.store_id = a.store_id
                        AND sc_app_store.as_of_date = a.application_created_at_ymd
  LEFT JOIN sc_app_merch ON sc_app_merch.merchant_id = a.merchant_id
                        AND sc_app_merch.as_of_date = a.application_created_at_ymd
  ---- Supercharge start/end: store-level wins, merchant-level fallback ----
  LEFT JOIN sc_store_span ON sc_store_span.store_id = a.store_id
  LEFT JOIN sc_merch_span ON sc_merch_span.merchant_id = a.merchant_id
  LEFT JOIN (select application_id,COC_PROJ_SIMPLE,FRAUD_MODEL_Q325 from PC_FIVETRAN_DB.PRODUCTION_PUBLIC.STG_SIMULATION_ATTRIBUTES_PROD) MS ON MS.APPLICATION_ID = A.APPLICATION_ID
  LEFT JOIN MR_DDM_TICKET_FLAGGING MDTF ON A.property_chain_id = mdtf.property_chain_id
  LEFT JOIN (SELECT 
    merchant_id,
    MAX(treatment_group) AS swap_in_treatment_group
FROM (
    SELECT 
        s.merchant_id AS merchant_id,
        CASE 
            WHEN param_1_min = 1.147 AND param_1_max IS NULL AND param_2_min IS NULL AND param_2_max = 0.0331 THEN 1
            WHEN param_1_min = 1.147 AND param_1_max IS NULL AND param_2_min = 0.0331 AND param_2_max IS NULL THEN 2
            WHEN param_1_min = 1.0904 AND param_1_max = 1.1470 AND param_2_min IS NULL AND param_2_max = 0.0331 THEN 3
            WHEN param_1_min = 1.0904 AND param_1_max = 1.1470 AND param_2_min = 0.0331 AND param_2_max = 0.0758 THEN 4
            WHEN param_1_min = 1.0144 AND param_1_max = 1.0904 AND param_2_min IS NULL AND param_2_max = 0.0671 THEN 5
            WHEN param_1_min = 0.9765 AND param_1_max = 1.0144 AND param_2_min IS NULL AND param_2_max = 0.0417 THEN 6
            WHEN param_1_min = 1.0904 AND param_1_max = 1.1470 AND param_2_min = 0.0758 AND param_2_max IS NULL THEN 7
            WHEN param_1_min = 1.0144 AND param_1_max = 1.0904 AND param_2_min = 0.0671 AND param_2_max IS NULL THEN 8
            WHEN param_1_min = 0.9765 AND param_1_max = 1.0144 AND param_2_min = 0.0417 AND param_2_max = 0.0758 THEN 9
            WHEN param_1_min IS NULL AND param_1_max = 0.9765 AND param_2_min IS NULL AND param_2_max = 0.0671 THEN 10
            WHEN param_1_min = 0.9765 AND param_1_max = 1.0144 AND param_2_min = 0.0758 AND param_2_max IS NULL THEN 11
            WHEN param_1_min IS NULL AND param_1_max = 0.9765 AND param_2_min = 0.0671 AND param_2_max = 0.1017 THEN 12
            WHEN param_1_min IS NULL AND param_1_max = 0.9765 AND param_2_min = 0.1017 AND param_2_max IS NULL THEN 13
        END AS treatment_group
            FROM PC_FIVETRAN_DB.STORE_TREATMENT.MERCHANT_FLAG_TREATMENT mft
    LEFT JOIN PC_FIVETRAN_DB.PRODUCTION_PUBLIC.STG_STORE s 
        ON s.merchant_id = mft.merchant_id

   -- WHERE flag_id = 'flag_00289'
)
GROUP BY merchant_id) as SIG on SIG.MERCHANT_ID = A.MERCHANT_ID
  LEFT JOIN (
    SELECT COMPANY_ID, MERCHANT_QUALITY_SCORE, MODEL_SCORES
    FROM PC_FIVETRAN_DB.PRODUCTION_PUBLIC.STG_MERCHANT_UNDERWRITING_SCORES_V2
    WHERE MODEL_VERSION = 'v2' AND MERCHANT_QUALITY_SCORE IS NOT NULL
    QUALIFY ROW_NUMBER() OVER (PARTITION BY COMPANY_ID ORDER BY COMPANY_ID) = 1
  ) prod_v2 ON TO_VARCHAR(prod_v2.COMPANY_ID) = TO_VARCHAR(a.HUBSPOT_COMPANY_ID)
  LEFT JOIN PC_FIVETRAN_DB.RISK_MODELING.MERCHANT_UW_V2_KAFENE_SCORES retro_v2 ON retro_v2.COMPANY_ID = TO_VARCHAR(a.HUBSPOT_COMPANY_ID)
  LEFT JOIN (
    SELECT property_store_id, property_termination_reason
    FROM PC_FIVETRAN_DB.HUBSPOT.DEAL
    WHERE property_store_id IS NOT NULL
      AND property_termination_reason IS NOT NULL
      AND property_termination_reason != ''
    QUALIFY ROW_NUMBER() OVER (PARTITION BY property_store_id ORDER BY property_closedate DESC NULLS LAST, property_createdate DESC) = 1
  ) deal ON deal.property_store_id = a.store_id
;
