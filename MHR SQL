and (a.d30_90d_model_q325 >= global_cap.d30_90d_min or global_cap.d30_90d_min is null)
and (a.d30_90d_model_q325 <= global_cap.d30_90d_max or global_cap.d30_90d_max is null)
and (a.d30_180d_model_q325 >= global_cap.d30_180d_min or global_cap.d30_180d_min is null)
and (a.d30_180d_model_q325 <= global_cap.d30_180d_max or global_cap.d30_180d_max is null)

QUALIFY ROW_NUMBER() OVER (PARTITION BY a.application_id ORDER BY a.created_at DESC) = 1
      ) a
      left join PC_FIVETRAN_DB.PRODUCTION_PUBLIC.STG_UNDERWRITING_METRICS uw on uw.application_id = a.application_id
  ),
  --------swap in date subquery---
  swap_in_date AS (
    WITH
      TransitionPoints AS --adds previous day credit_swap_in_grade to each row
      (
        SELECT
          STORE_ID,
          AS_OF_DATE,
          CREDIT_SWAP_IN_GRADE,
          LAG (CREDIT_SWAP_IN_GRADE) OVER (
            PARTITION BY
              STORE_ID
            ORDER BY
              AS_OF_DATE
          ) AS PREV_CREDIT_SWAP_IN_GRADE
        FROM
          PC_FIVETRAN_DB.PRODUCTION_PUBLIC.STG_STORE_TREATMENT_OVERVIEW as ssto
      ),
      RecentTransitions AS --filters for row(s) where credit_swap_in_grade changes from null to not null
      (
        SELECT
          STORE_ID,
          AS_OF_DATE
        FROM
          TransitionPoints
        WHERE
          CREDIT_SWAP_IN_GRADE is not null
          and PREV_CREDIT_SWAP_IN_GRADE is null
      ),
      MostRecentFirstActiveDay AS --select most recent date for each store_id where credit_swap_in_grade changes from null to not null
      (
        SELECT
          STORE_ID,
          MAX(AS_OF_DATE) AS FIRST_SWAP_IN_ACTIVE_DAY
        FROM
          RecentTransitions
        GROUP BY
          STORE_ID
      ),
      MostRecentLatestActiveDay AS (
        SELECT
          STORE_ID,
          MAX(AS_OF_DATE) AS LATEST_SWAP_IN_ACTIVE_DAY
        FROM
          PC_FIVETRAN_DB.PRODUCTION_PUBLIC.STG_STORE_TREATMENT_OVERVIEW
        WHERE
          CREDIT_SWAP_IN_GRADE is not null
        GROUP BY
          STORE_ID
      )
    SELECT
      a.ID AS STORE_ID,
      b.FIRST_SWAP_IN_ACTIVE_DAY,
      c.LATEST_SWAP_IN_ACTIVE_DAY
    FROM
      (
        SELECT DISTINCT
          ID
        FROM
          PC_FIVETRAN_DB.PRODUCTION_PUBLIC.STG_STORE
      ) as a
      LEFT JOIN MostRecentFirstActiveDay as b on a.id = b.store_id
      LEFT JOIN MostRecentLatestActiveDay as c on a.id = c.store_id
  ),
  ------------120 day EPO1----------
  EPO1_120_DAY_TABLE AS (
    WITH
      TransitionPoints AS --adds previous day pricing_tag to each row
      (
        SELECT
          ID AS STORE_ID,
          AS_OF_DATE,
          pricing_tag,
          LAG (pricing_tag) OVER (
            PARTITION BY
              ID
            ORDER BY
              AS_OF_DATE
          ) AS PREV_pricing_tag
        FROM
          PC_FIVETRAN_DB.PRODUCTION_PUBLIC.stg_store_history
      ),
      RecentTransitions AS --filters for row(s) where pricing_tag changes from Not 120EPO1 to 120EPO1
      (
        SELECT
          STORE_ID,
          AS_OF_DATE
        FROM
          TransitionPoints
        WHERE
          pricing_tag in (
            select distinct
              pricing_tag
            from
              PC_FIVETRAN_DB.PRODUCTION_PUBLIC.PRICING
            where
              pricing_tag like '%120EPO1%'
          )
          and PREV_pricing_tag not in (
            select distinct
              pricing_tag
            from
              PC_FIVETRAN_DB.PRODUCTION_PUBLIC.PRICING
            where
              pricing_tag like '%120EPO1%'
          )
        UNION ALL
        SELECT
          STORE_ID,
          AS_OF_DATE
        FROM
          TransitionPoints
        WHERE
          pricing_tag in (
            select distinct
              pricing_tag
            from
              PC_FIVETRAN_DB.PRODUCTION_PUBLIC.PRICING
            where
              pricing_tag like '%120EPO1%'
          )
          and PREV_pricing_tag is null
      ),
      MostRecentFirstActiveDay AS --select most recent date for each store_id where pricing_tag changes from Not 120EPO1 to 120EPO1
      (
        SELECT
          STORE_ID,
          MAX(AS_OF_DATE) AS FIRST_PRICING_ACTIVE_DAY
        FROM
          RecentTransitions
        GROUP BY
          STORE_ID
      ),
      MostRecentLatestActiveDay AS --select most recent date for each store_id where pricing_tag is 120EPO1
      (
        SELECT
          ID AS STORE_ID,
          MAX(AS_OF_DATE) AS LATEST_PRICING_ACTIVE_DAY
        FROM
          PC_FIVETRAN_DB.PRODUCTION_PUBLIC.STG_STORE_HISTORY
        WHERE
          PRICING_TAG in (
            select distinct
              pricing_tag
            from
              PC_FIVETRAN_DB.PRODUCTION_PUBLIC.PRICING
            where
              pricing_tag like '%120EPO1%'
          )
        GROUP BY
          STORE_ID
      )
    SELECT
      a.ID AS STORE_ID,
      b.first_pricing_active_day,
      c.LATEST_PRICING_ACTIVE_DAY
    FROM
      (
        SELECT DISTINCT
          ID
        FROM
          PC_FIVETRAN_DB.PRODUCTION_PUBLIC.STG_STORE
      ) as a
      LEFT JOIN MostRecentFirstActiveDay as b on a.id = b.store_id
      LEFT JOIN MostRecentLatestActiveDay as c on a.id = c.store_id
  ),
  ------------one dollar ip ----------
  ONE_DOLLAR_TABLE AS (
    WITH
      TransitionPoints AS --adds previous day pricing_tag to each row
      (
        SELECT
          ID AS STORE_ID,
          AS_OF_DATE,
          pricing_tag,
          LAG (pricing_tag) OVER (
            PARTITION BY
              ID
            ORDER BY
              AS_OF_DATE
          ) AS PREV_pricing_tag
        FROM
          PC_FIVETRAN_DB.PRODUCTION_PUBLIC.stg_store_history
      ),
      RecentTransitions AS --filters for row(s) where pricing_tag changes from Not $1 IP to $1IP
      (
        SELECT
          STORE_ID,
          AS_OF_DATE
        FROM
          TransitionPoints
        WHERE
          pricing_tag in (
            select distinct
              pricing_tag
            from
              PC_FIVETRAN_DB.PRODUCTION_PUBLIC.PRICING
            where
              signing_payment = 1
          )
          and PREV_pricing_tag not in (
            select distinct
              pricing_tag
            from
              PC_FIVETRAN_DB.PRODUCTION_PUBLIC.PRICING
            where
              signing_payment = 1
          )
        UNION ALL
        SELECT
          STORE_ID,
          AS_OF_DATE
        FROM
          TransitionPoints
        WHERE
          pricing_tag in (
            select distinct
              pricing_tag
            from
              PC_FIVETRAN_DB.PRODUCTION_PUBLIC.PRICING
            where
              signing_payment = 1
          )
          and PREV_pricing_tag is null
      ),
      MostRecentFirstActiveDay AS --select most recent date for each store_id where pricing_tag changes from Not $1 IP to $1IP
      (
        SELECT
          STORE_ID,
          MAX(AS_OF_DATE) AS FIRST_PRICING_ACTIVE_DAY
        FROM
          RecentTransitions
        GROUP BY
          STORE_ID
      ),
      MostRecentLatestActiveDay AS --select most recent date for each store_id where pricing_tag is $1IP
      (
        SELECT
          ID AS STORE_ID,
          MAX(AS_OF_DATE) AS LATEST_PRICING_ACTIVE_DAY
        FROM
          PC_FIVETRAN_DB.PRODUCTION_PUBLIC.STG_STORE_HISTORY
        WHERE
          PRICING_TAG in (
            select distinct
              pricing_tag
            from
              PC_FIVETRAN_DB.PRODUCTION_PUBLIC.PRICING
            where
              signing_payment = 1
          )
        GROUP BY
          STORE_ID
      ),
      od_start_end_date as (
        SELECT
          store_id,
          LEFT (MIN(created_at), 10) AS first_one_dollar_lease_created_at,
          LEFT (MAX(created_at), 10) AS last_one_dollar_lease_created_at
        FROM
          PC_FIVETRAN_DB.PRODUCTION_PUBLIC.STG_LEASE
        WHERE
          one_dollar_ip_flag = 1
        GROUP BY
          1
      )
    SELECT
      a.ID AS STORE_ID,
      CASE
        WHEN (
          b.first_pricing_active_day = '2024-01-17'
          or b.first_pricing_active_day is null
        ) THEN COALESCE(
          d.first_one_dollar_lease_created_at,
          b.first_pricing_active_day
        )
        ELSE b.FIRST_PRICING_ACTIVE_DAY
      END AS first_pricing_active_day,
      CASE
        WHEN (
          c.LATEST_PRICING_ACTIVE_DAY = '2024-01-17'
          or c.LATEST_PRICING_ACTIVE_DAY is null
        ) THEN COALESCE(
          d.last_one_dollar_lease_created_at,
          c.LATEST_PRICING_ACTIVE_DAY
        )
        ELSE c.LATEST_PRICING_ACTIVE_DAY
      END AS LATEST_PRICING_ACTIVE_DAY,
    FROM
      (
        SELECT DISTINCT
          ID
        FROM
          PC_FIVETRAN_DB.PRODUCTION_PUBLIC.STG_STORE
      ) as a
      LEFT JOIN MostRecentFirstActiveDay as b on a.id = b.store_id
      LEFT JOIN MostRecentLatestActiveDay as c on a.id = c.store_id
      LEFT JOIN od_start_end_date as d on a.id = d.store_id
  ),
  original_pricing as (
    select
      lease_id,
      JSON_EXTRACT_PATH_TEXT (contract_inputs, 'epo1_period') AS original_epo1_period,
      JSON_EXTRACT_PATH_TEXT (contract_inputs, 'term') AS original_term,
      ROUND(
        JSON_EXTRACT_PATH_TEXT (contract_inputs, 'total_of_payments_base'):: float / JSON_EXTRACT_PATH_TEXT (contract_inputs, 'kafene_cash_price_base'):: float,
        2
      ) AS original_lease_turns,
      ROUND(
        JSON_EXTRACT_PATH_TEXT (contract_inputs, 'initial_payment_base'),
        0
      ) AS original_ip
    from
      PC_FIVETRAN_DB.PRODUCTION_PUBLIC.lease_contracts
      left join PC_FIVETRAN_DB.PRODUCTION_PUBLIC.stg_lease on stg_lease.id = lease_contracts.lease_id
  ),
  NEW_COC_MODEL_SCORE AS (
    SELECT
      application_id,
      STG_STORE.STATE AS store_state,
      d30_180d_model_q125,
      fraud_model_q125,
      -- New model score calculation
      multiclass_5_current_180d_q125 * (
        CASE
          WHEN store_state IN ('CA') THEN 1.60
          WHEN store_state IN ('FL') THEN 1.65
          WHEN store_state IN ('TX') THEN 1.71
          WHEN store_state IN ('CT', 'HI', 'IA', 'ME', 'MI', 'NY', 'OH', 'PA', 'VT') THEN 1.58
          ELSE 1.68
        END
      ) + multiclass_4_dpd30_180d_q125 * (
        CASE
          WHEN store_state IN ('CA') THEN 0.67
          WHEN store_state IN ('FL') THEN 0.75
          WHEN store_state IN ('TX') THEN 0.76
          WHEN store_state IN ('CT', 'HI', 'IA', 'ME', 'MI', 'NY', 'OH', 'PA', 'VT') THEN 0.72
          ELSE 0.74
        END
      ) + multiclass_3_dpd30_90d_q125 * (
        CASE
          WHEN store_state IN ('CA') THEN 0.33
          WHEN store_state IN ('FL') THEN 0.35
          WHEN store_state IN ('TX') THEN 0.31
          WHEN store_state IN ('CT', 'HI', 'IA', 'ME', 'MI', 'NY', 'OH', 'PA', 'VT') THEN 0.25
          ELSE 0.34
        END
      ) + multiclass_2_epo1_q125 * (
        CASE
          WHEN store_state IN ('CA') THEN 1.00
          WHEN store_state IN ('FL') THEN 1.06
          WHEN store_state IN ('TX') THEN 1.05
          WHEN store_state IN ('CT', 'HI', 'IA', 'ME', 'MI', 'NY', 'OH', 'PA', 'VT') THEN 1.06
          ELSE 1.05
        END
      ) + multiclass_1_np_q125 * (
        CASE
          WHEN store_state IN ('CA') THEN 0.10
          WHEN store_state IN ('FL') THEN 0.06
          WHEN store_state IN ('TX') THEN 0.07
          WHEN store_state IN ('CT', 'HI', 'IA', 'ME', 'MI', 'NY', 'OH', 'PA', 'VT') THEN 0.02
          ELSE 0.07
        END
      ) AS COC_MODEL_SCORE
    FROM
      PC_FIVETRAN_DB.PRODUCTION_PUBLIC.STG_UNDERWRITING_METRICS
      LEFT JOIN PC_FIVETRAN_DB.PRODUCTION_PUBLIC.STG_STORE ON STG_STORE.ID = STG_UNDERWRITING_METRICS.STORE_ID
  ),
  store_coc_score as (
      WITH latest_scores AS (
  SELECT 
    company_id,
    MAX(model_run_date) AS latest_date
  FROM 
    PC_FIVETRAN_DB.PRODUCTION_PUBLIC.STG_MERCHANT_UNDERWRITING_SCORES
  GROUP BY 
    company_id
)
SELECT 
  s.id,
  mus.final_coc_prediction as store_final_coc_prediction,
