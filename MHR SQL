         CASE
        WHEN (a.sim_decision = 'Approve' AND a.sim_decision_wo_swap_in = 'Decline')
        THEN 1
        ELSE 0
        END AS SWAP_IN_MERCHANT_RULE_FLAG,
      CASE
        WHEN sim_decision = 'Approve'
        and sim_decision_wo_swap_in <> 'Approve' THEN 1
        ELSE 0
