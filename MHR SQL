case when counter_00001 > 0 and flag_00303*flag_00304>0 then 1000 else overlay_00047 end as overlay_00136,

coalesce(prq_approval_amount, case when a.current_balance is not null then ceil( floor(greatest(overlay_00136 - a.current_balance, 0))/50)*50 else 
ceil(floor(overlay_00136)/50)*50 end ) as overlay_00049,

      



    case
        --when flag_00308 > 0 then 'Approve'
