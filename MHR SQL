create or replace table PC_FIVETRAN_DB.YISHUANG_TEMP.MHR_PIVOT_DATA as 
--refresh related ticket and related store_id
with MR_DDM_TICKET_FLAGGING AS (
WITH TMP1 AS 
(
    SELECT
        B.PROPERTY_CHAIN_ID,
        LISTAGG(DISTINCT A.merchant_id, ', ') WITHIN GROUP (ORDER BY A.merchant_id) AS merchant_id,
        MAX(A.MERCHANT_NAME) AS MERCHANT_NAME,
        LISTAGG(DISTINCT A.pricing_tag, ', ') WITHIN GROUP (ORDER BY A.pricing_tag) AS pricing_tags,
        SUM(A.CONTRACTED_AMOUNT_LAST_CALENDAR_MONTH) AS CONTRACTED_AMOUNT_LAST_CALENDAR_MONTH,
        SUM(A.MAXIMUM_CONTRACTED_AMOUNT) AS MAXIMUM_CONTRACTED_AMOUNT
    FROM PC_FIVETRAN_DB.PRODUCTION_PUBLIC.STG_STORE_HISTORY AS A
    LEFT JOIN PC_FIVETRAN_DB.PRODUCTION_PUBLIC.STG_STORE AS B ON A.ID = B.ID
    --WHERE A.AS_OF_DATE = '2026-01-26' AND A.IS_STORE_LEVEL_BLOCKED = 'FALSE'
    --AND A.CATEGORY_NAME = 'Jewelry'
    GROUP BY b.PROPERTY_CHAIN_ID
),
TMP2 AS
(
SELECT 
    B.PROPERTY_CHAIN_ID,
    A.KEY,
    MAX(A.TICKET_CREATED_AT) AS  TICKET_CREATED_AT
FROM PC_FIVETRAN_DB.PRODUCTION_PUBLIC.STG_STORE_RETENTION_PERIOD AS A
LEFT JOIN PC_FIVETRAN_DB.PRODUCTION_PUBLIC.STG_STORE AS B ON A.STORE_ID = B.ID
GROUP BY 1,2
)
--SELECT * FROM TMP2
,
TMP3 AS
(
SELECT
        TMP2.PROPERTY_CHAIN_ID,
        TMP2.KEY,
        TMP2.ticket_created_at,
        ROW_NUMBER() OVER (
            PARTITION BY TMP2.PROPERTY_CHAIN_ID
            ORDER BY TMP2.ticket_created_at DESC
        ) AS rn
    FROM TMP2
)
--SELECT * FROM TMP3
,
tmp4a as 
(
    SELECT
        A.PROPERTY_CHAIN_ID,
        LISTAGG(A.key, ', ')
            WITHIN GROUP (ORDER BY A.rn) AS keys_chronological
    FROM (
        SELECT DISTINCT
            TMP3.PROPERTY_CHAIN_ID,
            TMP3.key,
            TMP3.rn
        FROM tmp3
    ) AS A
    GROUP BY a.PROPERTY_CHAIN_ID
)
--SELECT * FROM TMP4a
,
tmp4b as 
(
    SELECT
        tmp3.PROPERTY_CHAIN_ID,
        tmp3.key AS most_recent_key,
        ticket_created_at AS most_recent_key_date
        FROM tmp3
        WHERE rn = 1
)
--select * from tmp4b
,tmp5 as
(
    SELECT 
    --s.id AS store_id,
    s.property_chain_id,
    min(coalesce(param_1_min,2)) AS BV_MIN, max(coalesce(param_1_max,10)) AS BV_MAX
    FROM  PC_FIVETRAN_DB.STORE_TREATMENT.MERCHANT_FLAG_TREATMENT mft
    LEFT JOIN PC_FIVETRAN_DB.PRODUCTION_PUBLIC.STG_STORE s ON s.merchant_id = mft.merchant_id
    where flag_id = 'flag_00292' and s.is_store_level_blocked = 'FALSE'
    group by 1
)
SELECT TMP1.*,
tmp4b.most_recent_key_date,
tmp4b.most_recent_key,
tmp4a.keys_chronological as related_keys,
tmp5.BV_MIN,
tmp5.BV_MAX
FROM TMP1
LEFT JOIN TMP4a on tmp1.property_chain_id = tmp4a.property_chain_id
LEFT JOIN TMP4b on tmp1.property_chain_id = tmp4b.property_chain_id
LEFT JOIN TMP5 on tmp1.property_chain_id = tmp5.property_chain_id
ORDER BY CONTRACTED_AMOUNT_LAST_CALENDAR_MONTH DESC
)
,
  ----pricing app level table----
