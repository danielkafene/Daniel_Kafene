  activation_terms AS (
    WITH act_s AS (
      SELECT id, initial_activated_at::DATE act
      FROM pc_fivetran_db.production_public.stg_store
    ),
    act_sh AS (
      SELECT h.id AS store_id, h.as_of_date, h.pricing_tag, h.state
      FROM pc_fivetran_db.production_public.stg_store_history h
      JOIN act_s ON act_s.id = h.id
      WHERE h.as_of_date >= act_s.act
      QUALIFY ROW_NUMBER() OVER (PARTITION BY h.id ORDER BY h.as_of_date) = 1
    )
    SELECT
      act_sh.store_id,
      CASE
        WHEN MAX(IFF(p.ownership_terms = 12, 1, 0)) = 1 AND MAX(IFF(p.ownership_terms >= 18, 1, 0)) = 1 THEN '01. Both 12M & 18M'
        WHEN MAX(IFF(p.ownership_terms = 12, 1, 0)) = 1 THEN '02. Only 12M'
        WHEN MAX(IFF(p.ownership_terms >= 18, 1, 0)) = 1 THEN '03. Only 18M'
        ELSE '04. Other'
      END AS activation_term_flag,
      CASE
        WHEN MIN(p.epo1_period) <= 100 THEN 1
        ELSE 0
      END AS "epo1<=100D"
    FROM act_sh
    LEFT JOIN pc_fivetran_db.production_public.state_tax st ON st.state_code = act_sh.state
    LEFT JOIN pc_fivetran_db.production_public.stg_pricing_history p
      ON p.as_of_date = act_sh.as_of_date
      AND p.deprecated_date IS NULL
      AND (
        (act_sh.pricing_tag IS NOT NULL AND p.pricing_tag = act_sh.pricing_tag)
        OR (act_sh.pricing_tag IS NULL AND p.pricing_tag IS NULL AND p.regulation_id = st.regulation_id)
      )
    GROUP BY 1
  ),
  ---- Supercharge at application date: store-scoped rows (flattened) ----
  sc_app_store AS (
    SELECT
        f.value::STRING AS store_id,
        t.as_of_date,
        CASE
            WHEN t.PARAM_1_MAX = 0.386 THEN '15'
            WHEN t.PARAM_1_MAX = 0.333 THEN '10a'
            WHEN t.PARAM_1_MAX = 0.260 THEN '5a'
            WHEN t.PARAM_1_MAX = 0.316 THEN '10b'
            WHEN t.PARAM_1_MAX = 0.250 THEN '5b'
            ELSE NULL
        END AS supercharge_group
    FROM PC_FIVETRAN_DB.PRODUCTION_PUBLIC.STG_UNDERWRITING_MERCHANT_FLAG_TREATMENT t,
         LATERAL FLATTEN(input => t.store_ids) f
    WHERE t.flag_id = 'flag_00308'
      -- old label (2026-06-12 to 2026-10-04) + new label (2026-09-01 onward), same thresholds
      AND t.param_1_label IN ('model_scores:D30_180D_MODEL_Q325:score', 'model_pointers:D30_180D_MODEL')
      AND t.store_scope = 'ONLY'
      AND supercharge_group IS NOT NULL
    -- one row per store per day (labels overlap + duplicate daily rows); prefer new label
    QUALIFY ROW_NUMBER() OVER (
        PARTITION BY f.value::STRING, t.as_of_date
        ORDER BY IFF(t.param_1_label = 'model_pointers:D30_180D_MODEL', 0, 1), t.param_1_max DESC
    ) = 1
  ),
  ---- Supercharge at application date: merchant-wide fallback ----
  sc_app_merch AS (
    SELECT
        t.merchant_id,
        t.as_of_date,
        CASE
            WHEN t.PARAM_1_MAX = 0.386 THEN '15'
            WHEN t.PARAM_1_MAX = 0.333 THEN '10a'
            WHEN t.PARAM_1_MAX = 0.260 THEN '5a'
            WHEN t.PARAM_1_MAX = 0.316 THEN '10b'
            WHEN t.PARAM_1_MAX = 0.250 THEN '5b'
            ELSE NULL
        END AS supercharge_group
    FROM PC_FIVETRAN_DB.PRODUCTION_PUBLIC.STG_UNDERWRITING_MERCHANT_FLAG_TREATMENT t
    WHERE t.flag_id = 'flag_00308'
      -- old label (2026-06-12 to 2026-10-04) + new label (2026-09-01 onward), same thresholds
      AND t.param_1_label IN ('model_scores:D30_180D_MODEL_Q325:score', 'model_pointers:D30_180D_MODEL')
      AND t.store_scope IS NULL
      AND supercharge_group IS NOT NULL
    -- one row per merchant per day (labels overlap + duplicate daily rows); prefer new label
    QUALIFY ROW_NUMBER() OVER (
        PARTITION BY t.merchant_id, t.as_of_date
        ORDER BY IFF(t.param_1_label = 'model_pointers:D30_180D_MODEL', 0, 1), t.param_1_max DESC
