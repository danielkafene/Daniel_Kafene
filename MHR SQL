  ----SWAP IN FLAG TABLE SUBQUERY---
  SWAP_IN_FLAG_TABLE as (
    SELECT
      a.APPLICATION_ID,
      CASE
        WHEN (a.sim_decision = 'Approve' AND a.sim_decision_wo_swap_in = 'Decline')
       OR (a.sim_decision = 'Decline' AND uw.final_decision = 'Approved')
        THEN 1
