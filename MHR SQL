      (
        select
          a.application_ID,
          case when flag_00274 = 1 then greatest(overlay_00132, rpc_pre_lease_appr_amt)
else overlay_00132 end as overlay_00126,

case when flag_00267 = 1 then greatest(overlay_00126, 1.1*last_approval_amount)
else overlay_00126 end as overlay_00122,

case when global_cap.merchant_id is not null then least(overlay_00122,global_cap.impact)
