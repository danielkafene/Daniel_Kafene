        when decision_1 = 'Decline' and flag_00303*flag_00304>0 then 'Manual'
        when decision_1 = 'Decline' and flag_00311*(1-flag_00259)*(1-flag_00260)>0 then 'Manual'
    else decision_1 end sim_decision_wo_swap_in,
          ----------------------------------------------
                    case
        when flag_00308 > 0 then 'Approve'
        when flag_00285+flag_00286+flag_00299+flag_00297+flag_00272+flag_00273+flag_00300+flag_00301+flag_00302+flag_00305+flag_00306>0 then 'Decline'
        when flag_00289>0 and counter_00001<4 then 'Approve'
        when flag_00312>0 then 'Approve'
        when flag_00283*(1-flag_00292) > 0  then 'Approve'
        when flag_00276 = 1 then 'Approve'
        when flag_00216+flag_00217+flag_00218+flag_00291+flag_00271+flag_00284 > 0 then 'Decline'
        when flag_00274 = 1 then 'Approve'
        when flag_00106+flag_00222+flag_00290
        +flag_00268+flag_00269+flag_00275+flag_00282 >0 
        then 'Decline'
        when flag_00259*( flag_00288*(1-flag_00072)+flag_00292 )>0 then 'Approve'
        when flag_00260*( flag_00288*(1-flag_00072)+flag_00292 )>0 then 'Decline'
        when flag_00288*(1-flag_00072)+flag_00292>0 then 'Manual'
        else 'Approve'
        end as decision_2,

    case when knockout_1 = 1 then 'Decline'
        when overlay_00049<300 then 'Decline'
        when flag_00211 = 1 then 'Decline'
        when flag_00267 = 1 then 'Approve'
        when flag_00287 = 1 then 'Decline'
        when decision_2 = 'Decline' and flag_00310>0 then 'Approve'
        when decision_2 = 'Decline' and flag_00309>0 then 'Manual'
        when decision_2 = 'Decline' and flag_00303*flag_00304>0 then 'Manual'
        when decision_2 = 'Decline' and flag_00311*(1-flag_00259)*(1-flag_00260)>0 then 'Manual'
    else decision_2 end as sim_decision

        from
          PC_FIVETRAN_DB.PRODUCTION_PUBLIC.stg_simulation_line_prod_step3 a
      left join PC_FIVETRAN_DB.PRODUCTION_PUBLIC.STG_MERCHANT_LINE_TREATMENT_SIMU global_cap
on a.merchant_id = global_cap.merchant_id
and global_cap.treatment_type = 'glob_cap'
